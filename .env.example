# העתיקו קובץ זה ל-.env ומלאו את הפרטים האמיתיים (קובץ .env לא נכנס ל-git).

# חיבור ל-MongoDB Atlas: ה-<PASSWORD> מוחלף אוטומטית בערך של DATABASE_PASSWORD.
DATABASE=mongodb+srv://USER:<PASSWORD>@cluster0.xxxxx.mongodb.net/DBNAME?retryWrites=true&w=majority&appName=Cluster0
DATABASE_PASSWORD=your-db-password
# לחלופין URI מלא במקום DATABASE/DATABASE_PASSWORD:
# MONGODB_URI=
# אם משאירים את הכל ריק בפיתוח — השרת יעלה MongoDB זמני בזיכרון.

PORT=5000

# סיסמת מנהל לכניסה ללוח הבקרה ולייצוא האקסל. אם ריק — נתיבי הניהול פתוחים (לא מומלץ).
ADMIN_TOKEN=choose-a-strong-secret

# הגבלת CORS ל-origin ספציפי בפרודקשן (אפשר כמה, מופרדים בפסיק). ריק = פתוח.
# CLIENT_ORIGIN=https://your-domain.com

# הגבלת קצב לטופס הציבורי (ברירת מחדל: 100 בקשות ל-5 דקות לכל IP)
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=300000

# אם רצים מאחורי reverse proxy, להגדרת זיהוי IP נכון עבור הגבלת הקצב:
# TRUST_PROXY=1
